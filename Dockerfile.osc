# OSC build of the Liivo Studio workspace: one instance per project workspace,
# running the Coder agent (not the Coder server).
#
# Differences from liivo-studio/images/workspace/Dockerfile: no Docker engine and
# no sudo (OSC instances run unprivileged), and the `coder` binary is bundled from
# the pinned official image so it matches the server (the `coder-coder` block runs
# the same tag) and needs no download through the OSC login gate.

# Keep this tag equal to the tag in eyevinn-osaas/coder Dockerfile.osc.
FROM ghcr.io/coder/coder:v2.38.10 AS coder

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git openssh-client jq ripgrep unzip less vim \
      build-essential python3 iproute2 procps tini \
 && rm -rf /var/lib/apt/lists/*

COPY --from=coder --chmod=755 /opt/coder /usr/local/bin/coder

# Non-root user, uid 1000. No sudo and no extra groups.
RUN userdel -r ubuntu 2>/dev/null || true \
 && useradd -m -s /bin/bash -u 1000 coder

# mise: per-project runtime versions (node, python, go, ...) from the repo's
# .tool-versions / mise.toml / package.json engines.
ARG MISE_VERSION=v2026.11.9
RUN curl -fsSL https://mise.run | MISE_VERSION=${MISE_VERSION} MISE_INSTALL_PATH=/usr/local/bin/mise sh
ENV MISE_DATA_DIR=/home/coder/.local/share/mise \
    PATH=/home/coder/.local/share/mise/shims:/home/coder/.local/bin:$PATH

USER coder
WORKDIR /home/coder
# A default Node so Claude Code and JS projects work before any project setup.
# Claude Code is pinned: the bridge's flags are coupled to the CLI version (at least 2.1.259
# for the permission prompts it relays; 2.1.323 is what its stream-json round trip was run
# against). The bridge starts it with DISABLE_UPDATES=1, so the pinned binary is the one that runs.
ARG CLAUDE_CODE_VERSION=2.1.323
# pipefail: a failed download must fail the build (a plain pipe reports only bash's status). The version
# assertion (first word of `claude --version` equals the pin) catches an installer that ignores the pinned argument or leaves no binary.
RUN mise use -g node@22 && npm i -g corepack && corepack enable
RUN bash -o pipefail -c 'curl -fsSL https://claude.ai/install.sh | bash -s "$CLAUDE_CODE_VERSION"' \
 && [ "$(claude --version | head -n1 | awk '{print $1}')" = "${CLAUDE_CODE_VERSION}" ]

# Image copy of home, restored into an empty home volume on first start.
USER root
RUN cp -a /home/coder /opt/home-skel
COPY --chmod=755 osc-entrypoint.sh /usr/local/bin/osc-entrypoint.sh
# Edit proxy and preview forwarder on PORT (node:* modules only), with its token
# module, the git status reader and the git credential helper. Every file the
# forwarder requires must be listed here. Uses the default Node from mise, which
# the entrypoint has on PATH.
COPY --chmod=644 forwarder/preview-forwarder.js forwarder/auth.js forwarder/workspace-status.js forwarder/git-credential-liivo.js forwarder/inject.js forwarder/bridge-fetch.js forwarder/default-start-status.js /usr/local/lib/liivo/
# The default start for a repository without .liivo/start.sh (docs/block.md). Executable: the entrypoint
# and the bridge's restart both run it as a program.
COPY --chmod=755 default-start.js /usr/local/lib/liivo/
# Git credentials for github.com come from the gateway through the edit proxy;
# the helper prints nothing (git goes unauthenticated) when that fails.
RUN git config --system 'credential.https://github.com.helper' '!node /usr/local/lib/liivo/git-credential-liivo.js'

USER 1000:1000
# The orchestrator does not set PORT; the container port is fixed at 8080.
ENV PORT=8080
# The commit author of the bridge's per-turn commits; the entrypoint sets it when the home volume has no
# git identity (N3, birme on Eyevinn/liivo-studio#44).
ENV LIIVO_GIT_AUTHOR_NAME="Liivo Studio" LIIVO_GIT_AUTHOR_EMAIL="noreply@liivo.ai"
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/osc-entrypoint.sh"]
